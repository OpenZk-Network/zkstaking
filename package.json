  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "verify": "hardhat verify",
    "deploy:token": "npx hardhat ignition deploy ignition/modules/TokenModule.ts --network sepolia",
    "deploy:lm": "npx hardhat ignition deploy ignition/modules/LiquidityManagerModule.ts --network mainnet --verify",
    "deploy:rp": "npx hardhat ignition deploy ignition/modules/RocketPoolVaultModule.ts --network mainnet --verify",
    "deploy:rp:upgrade": "npx hardhat ignition deploy ignition/modules/RocketPoolVaultUpgradeModule.ts --network mainnet --verify",
    "deploy:oracle": "npx hardhat ignition deploy ignition/modules/ChainlinkOracleModule.ts --network mainnet --verify",
    "deploy:eigen": "npx hardhat ignition deploy ignition/modules/EigenLayerRETHVaultModule.ts --network mainnet --verify",
    "deploy:ozeth": "npx hardhat ignition deploy ignition/modules/ozETHModule.ts --network mainnet --verify",
    "deploy:usds": "npx hardhat ignition deploy ignition/modules/ozUSDVaultModule.ts --network mainnet --verify"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomiclabs/hardhat-solhint": "^4.0.1",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=18.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.13.3",
    "hardhat": "^2.22.18",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.2",
    "solidity-coverage": "^0.8.0",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.3.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "@uniswap/v3-periphery": "^1.4.4",
    "dotenv": "^16.4.5"
  },
